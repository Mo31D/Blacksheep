{
  "name": "black-sheep-commerce-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm run test && npm run dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dry-run": "wrangler deploy --env staging --dry-run --outdir .wrangler-dist",
    "dev": "wrangler dev --env staging",
    "preview": "wrangler preview --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.135.0"
  }
}
